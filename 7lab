#JS
// Цены и начальные остатки (из 4-й лабы)
const medicines = {
    "Аспирин - 50 руб.": { price: 50, stock: 884 },
    "Но-шпа - 120 руб.": { price: 120, stock: 396 },
    "Цитрамон - 30 руб.": { price: 30, stock: 1188 },
    "Амоксициллин - 250 руб.": { price: 250, stock: 126 },
    "Парацетамол - 40 руб.": { price: 40, stock: 745 },
    "Лоратадин - 80 руб.": { price: 80, stock: 377 }
};

// Получаем элементы страницы
const medicineSelect = document.getElementById('medicine');
const quantityInput = document.getElementById('quantity');
const totalInput = document.getElementById('total');
const calcBtn = document.getElementById('calcBtn');
const sellBtn = document.getElementById('sellBtn');
const resultDiv = document.getElementById('result');

// Функция обновления таблицы остатков
function updateStockTable() {
    const tableBody = document.querySelector('#stockTable tbody');
    tableBody.innerHTML = '';
    
    for (const [name, data] of Object.entries(medicines)) {
        const row = tableBody.insertRow();
        const medName = name.split(' - ')[0];
        row.insertCell(0).textContent = medName;
        row.insertCell(1).textContent = data.price;
        row.insertCell(2).textContent = data.stock;
    }
}

// Функция расчёта стоимости
function calculateTotal() {
    const selectedMedicine = medicineSelect.value;
    const quantity = parseInt(quantityInput.value);
    
    if (isNaN(quantity) || quantity <= 0) {
        totalInput.value = '0';
        return;
    }
    
    const price = parseInt(selectedMedicine);
    const total = price * quantity;
    totalInput.value = total;
}

// Функция продажи
function sellMedicine() {
    const selectedText = medicineSelect.options[medicineSelect.selectedIndex].text;
    const selectedMedicine = medicineSelect.value;
    const quantity = parseInt(quantityInput.value);
    const total = parseInt(totalInput.value);
    
    // Проверки
    if (isNaN(quantity) || quantity <= 0) {
        resultDiv.innerHTML = '<p style="color: red;">❌ Ошибка: введите количество!</p>';
        resultDiv.style.backgroundColor = '#ffe8e8';
        return;
    }
    
    if (!medicines[selectedText]) {
        resultDiv.innerHTML = '<p style="color: red;">❌ Ошибка: лекарство не найдено!</p>';
        return;
    }
    
    if (medicines[selectedText].stock < quantity) {
        resultDiv.innerHTML = `<p style="color: red;">❌ Ошибка: недостаточно товара! Остаток: ${medicines[selectedText].stock} упаковок.</p>`;
        resultDiv.style.backgroundColor = '#ffe8e8';
        return;
    }
    
    // Списание остатка
    medicines[selectedText].stock -= quantity;
    
    // Обновление таблицы
    updateStockTable();
    
    // Вывод чека
    resultDiv.innerHTML = `
        <h3>🧾 Чек</h3>
        <p>Препарат: ${selectedText.split(' - ')[0]}</p>
        <p>Количество: ${quantity} упаковок</p>
        <p>Цена за упаковку: ${medicines[selectedText].price} руб.</p>
        <p><strong>Итого: ${total} рублей</strong></p>
        <p>✅ Продажа оформлена! Спасибо за покупку!</p>
        <p>Остаток на складе: ${medicines[selectedText].stock} упаковок</p>
    `;
    resultDiv.style.backgroundColor = '#e8f0e8';
    
    // Очистка
    quantityInput.value = '1';
    calculateTotal();
}

// Привязываем события к кнопкам
calcBtn.addEventListener('click', calculateTotal);
sellBtn.addEventListener('click', sellMedicine);

// Событие при изменении выбора лекарства
medicineSelect.addEventListener('change', calculateTotal);

// Событие при вводе количества
quantityInput.addEventListener('input', calculateTotal);

// Инициализация
calculateTotal();
updateStockTable();






