                <tr><td>Амоксициллин</td><td>250</td><td>126</td></tr>
                <tr><td>Парацетамол</td><td>40</td><td>745</td></tr>
                <tr><td>Лоратадин</td><td>80</td><td>377</td></tr>
            </tbody>
        </table>
    </div>
</body>
</html>

